# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
venv/
env/
ENV/
.venv/

# Secrets / environment variables
.env
.env.*

# Jupyter Notebook checkpoints
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# Streamlit local secrets / config
.streamlit/secrets.toml

# IDE & Editor files
.vscode/
.idea/
*.swp
*.swo

# OS generated files
.DS_Store
Thumbs.db
desktop.ini

# Documentation & Office files (lock files, Word, PowerPoint)
Docs/
*.docx
*.doc
*.pptx
*.ppt
~$*
*.lock

# Temporary logs
*.log

# Large local datasets. Note: Data/Cleaned/model_ready_data.csv and the
# other CSVs already committed to this repo stay tracked (a .gitignore
# rule never untracks a file already in git) and the app's pre-season
# baseline fallback in src/features.py depends on that exact file being
# present -- this rule only stops *new*, not-yet-tracked CSVs (scratch
# exports, re-pulled raw data) from being added by accident. Updating an
# already-tracked CSV on purpose still works with `git add`; git only
# needs `-f` for a CSV that was never tracked before.
*.csv
